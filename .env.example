# Copy this file to .env.local and fill in your values

# Anthropic API Key (required for AI coach + product advice)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (Phase 2 - user profiles & data persistence)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Open Food Facts (Phase 2 - real barcode scanning)
# Free API - no key needed, just enable in config
VITE_OFF_API_ENABLED=false
